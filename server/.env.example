# Puerto de la API
PORT=3000

# Origen permitido para CORS (el dev server de React)
CLIENT_ORIGIN=http://localhost:5173

# Token para los endpoints de administración (método "Bearer")
# Genéralo con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=cambia-este-token

# URL del CSV publicado de Google Sheets con el inventario
# (Archivo → Compartir → Publicar en la web → formato CSV).
# Vacía = usar docs/sample-products.csv como catálogo inicial.
SHEET_CSV_URL=
