# Puerto de la API
PORT=3000

# Origen permitido para CORS (el dev server de React)
CLIENT_ORIGIN=http://localhost:5173

# Token para los endpoints de administración (método "Bearer")
# Genéralo con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=cambia-este-token

# URL del CSV publicado de Google Sheets con el inventario
# (Archivo → Compartir → Publicar en la web → formato CSV).
# Vacía = usar docs/sample-products.csv como catálogo inicial.
SHEET_CSV_URL=

# LLM para el chatbot (opcional). Si LLM_MODEL está vacío, el bot responde
# con plantilla (sin coste). Cualquier API compatible con OpenAI funciona:
#
#   Ollama (local y gratis, sin clave):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.2
#     LLM_API_KEY=
#
#   Groq (tier free, clave en console.groq.com):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#     LLM_API_KEY=gsk_...
#
#   Google Gemini (free tier, clave en aistudio.google.com):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.0-flash
#     LLM_API_KEY=AIza...
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
