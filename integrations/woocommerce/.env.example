# URL de tu tienda WooCommerce (sin /wp-json; se añade automáticamente)
WOO_URL=https://tu-tienda.com

# Consumer key/secret: WooCommerce → Ajustes → Avanzado → API REST → Crear clave
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL del CSV publicado de Google Sheets (Archivo → Compartir → Publicar en la web → CSV)
# o una ruta local a un archivo CSV (ej. ../../docs/sample-products.csv)
SHEET_CSV_URL=
